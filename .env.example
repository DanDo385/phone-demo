# Variable reference. Placeholders only. Do not put real secrets here.
# Real values come from the 1Password Environment `phone-demo-dev` (see .1password/project.toml),
# mounted at .env. Do not copy this file over a mounted .env. See docs/SETUP.md.

APP_BASE_URL=http://localhost:3000
DEMO_OWNER_PASSWORD=palmetto-demo
DEMO_SESSION_SECRET=replace-with-a-long-random-string

# ElevenLabs Agents. Leave blank to use the simulated receptionist.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_VOICE_AVERY=
ELEVENLABS_VOICE_JORDAN=
ELEVENLABS_VOICE_RILEY=
# Set to true only when you intend to create a new demo agent. Never points at production by default.
ELEVENLABS_ALLOW_AGENT_CREATE=false
ELEVENLABS_ALLOW_AGENT_UPDATE=false

# Twilio. Leave blank until a designated demo number is selected.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=
OWNER_FORWARD_NUMBER=
TWILIO_ALLOW_UNSIGNED=false

# AgentMail. Real sends also require TEST_CUSTOMER_EMAIL.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
AGENTMAIL_WEBHOOK_SECRET=

# Google Calendar OAuth. An API key alone cannot read a private calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# TypeSafe Jev. Scores records only. Empty means rules, marked degraded. Never posts the ledger.
JEV_API_KEY=
JEV_MODEL=jev-latest

# Optional later. This demo persists to local SQLite when these are empty.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Designated test recipient. Real email and calls are refused for every other address.
TEST_CUSTOMER_EMAIL=
TEST_CUSTOMER_PHONE=

# Shared secret ElevenLabs sends on tool webhooks.
TOOL_WEBHOOK_SECRET=

# Optional review destinations. Empty values use local fictional preview pages.
REVIEW_GOOGLE_URL=
REVIEW_FACEBOOK_URL=

# Recording stays off unless you explicitly enable a demo recording.
RECORD_CALLS=false

# ---- Public site ----
# PageSpeed Insights reuses GOOGLE_MAPS_API_KEY (same Google Cloud key); no separate key.
GOOGLE_MAPS_API_KEY=

# Google Calendar that holds prospect walkthrough bookings (same OAuth client as GOOGLE_CALENDAR_ID).
WALKTHROUGH_CALENDAR_ID=

# Sample images for website previews. Always labeled as sample images; never shown as a real client or team.
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# Cloudflare Turnstile in front of every paid third-party call. The site key is public but is still
# read on the server and passed to the page; do not add a NEXT_PUBLIC_ prefix to any variable here.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Product analytics. Empty means events stay in the local `events` table only.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Salt for hashing caller numbers in analytics and logs. Long random string; never reuse another secret.
CALLER_HASH_SALT=

# Where new-lead and booking notifications go (our staff inbox, not a prospect).
NOTIFY_EMAIL=

# Feature flags. "true" enables; anything else is off.
FEATURE_SMS=false
FEATURE_SHOW_SCORE=false
# "true" stops new prospect demos, calls, and paid API use; existing pages show a paused notice.
DEMO_KILL_SWITCH=false

# Litestream replication of the SQLite database (deploy/litestream.yml) to an S3-compatible bucket.
# Also used by deploy/backup-files.sh for recordings, attachments, and invoices.
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=us-east-1
LITESTREAM_PATH=prod
