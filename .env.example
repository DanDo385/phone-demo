# Variable reference. Placeholders only. Do not put real secrets here.
# Real values come from the 1Password Environment `phone-demo-dev` (see .1password/project.toml),
# mounted at .env. Do not copy this file over a mounted .env. See docs/SETUP.md.

APP_BASE_URL=http://localhost:3000
DEMO_OWNER_PASSWORD=palmetto-demo
DEMO_SESSION_SECRET=replace-with-a-long-random-string

# ElevenLabs Agents. Leave blank to use the simulated receptionist.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_VOICE_AVERY=
ELEVENLABS_VOICE_JORDAN=
ELEVENLABS_VOICE_RILEY=
# Set to true only when you intend to create a new demo agent. Never points at production by default.
ELEVENLABS_ALLOW_AGENT_CREATE=false
ELEVENLABS_ALLOW_AGENT_UPDATE=false

# Twilio. Leave blank until a designated demo number is selected.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=
OWNER_FORWARD_NUMBER=
TWILIO_ALLOW_UNSIGNED=false

# AgentMail. Real sends also require TEST_CUSTOMER_EMAIL.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
AGENTMAIL_WEBHOOK_SECRET=

# Google Calendar OAuth. An API key alone cannot read a private calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# TypeSafe Jev. Scores records only. Empty means rules, marked degraded. Never posts the ledger.
JEV_API_KEY=
JEV_MODEL=jev-latest

# Optional later. This demo persists to local SQLite when these are empty.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Designated test recipient. Real email and calls are refused for every other address.
TEST_CUSTOMER_EMAIL=
TEST_CUSTOMER_PHONE=

# Shared secret ElevenLabs sends on tool webhooks.
TOOL_WEBHOOK_SECRET=

# Optional review destinations. Empty values use local fictional preview pages.
REVIEW_GOOGLE_URL=
REVIEW_FACEBOOK_URL=

# Recording stays off unless you explicitly enable a demo recording.
RECORD_CALLS=false
