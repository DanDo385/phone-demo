# Copies recordings, attachments, and invoices (everything in the data directory except the
# SQLite files, which Litestream owns) to the same bucket. Triggered by the .timer.
[Unit]
Description=Docent Solutions file backup (recordings, attachments, invoices)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=docent
Group=docent
EnvironmentFile=/etc/docent/op.env
Environment=HOME=/var/lib/docent
ExecStart=/usr/bin/op run --env-file=/etc/docent/litestream.env.tpl -- /srv/docent/deploy/backup-files.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/docent
