# Continuous SQLite replication to the S3-compatible bucket. Use this unit instead of the
# litestream.service shipped by the .deb, so credentials come from 1Password.
[Unit]
Description=Docent Solutions SQLite replication (Litestream)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=docent
Group=docent
EnvironmentFile=/etc/docent/op.env
Environment=HOME=/var/lib/docent
ExecStart=/usr/bin/op run --env-file=/etc/docent/litestream.env.tpl -- /usr/bin/litestream replicate -config /etc/docent/litestream.yml
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/docent

[Install]
WantedBy=multi-user.target
